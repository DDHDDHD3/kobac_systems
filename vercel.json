{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60
    },
    "api/auth/login.ts": {
      "maxDuration": 60
    },
    "api/ai/chat.ts": {
      "maxDuration": 60
    },
    "api/ai/scope.ts": {
      "maxDuration": 60
    }
  }
}
